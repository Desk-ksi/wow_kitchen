<main class="container auth-wrap">
  <div class="auth-card row g-0 mx-auto" style="max-width: 960px;">
    <!-- 写真 -->
    <div class="col-lg-5 auth-visual">
      <%= image_tag "wow_kitchen_user_login.jpeg", alt: "屋台で料理する様子" %>
      <p class="auth-visual-text">世界のレシピと<br>出会う旅へ。</p>
    </div>
    <div class="col-lg-7 auth-form">
      <div class="wk-tag">WELCOME FOODIES</div>
      <h1 class="auth-title">新規ユーザー登録</h1>
      <%= form_for(resource, as: resource_name, url: registration_path(resource_name)) do |f| %>
        <%= render "devise/shared/error_messages", resource: resource %>
          <div class="mb-3">
            <p><%= f.label :nickname, "ニックネーム", class: "form-label auth-label" %></p>
            <p><%= f.text_field :nickname, autofocus: true, autocomplete: "email", id: "user_nickname", class:"form-control auth-input" %></p>
        </div>
          <div class="mb-3">
            <p><%= f.label :email, "メールアドレス", class: "form-label auth-label" %></p>
            <p><%= f.email_field :email, autofocus: true, autocomplete: "email", id: "user_email", class:"form-control auth-input" %></p>
          </div>
          <div class="mb-3">
            <p><%= f.label :password, "パスワード", class: "form-label auth-label" %></p>
            <% if @minimum_password_length %>
              <p><em>(<%= @minimum_password_length %> 文字以上で設定してください)</em></p>
            <% end %>
            <p><%= f.password_field :password, autocomplete: "new-password", id: "user_password", class: "form-control auth-input" %></p>
          </div>
          <div class="mb-4">
            <p><%= f.label :password_confirmation, "パスワード確認用", class: "form-label auth-label" %></p>
            <p><%= f.password_field :password_confirmation, autocomplete: "new-password", id: "user_password_confirmation", class: "form-control auth-input"%></p>
          </div>
          <div class="actions">
            <%= button_tag type: :submit, class: "wk-btn wk-btn-primary w-100" do %>
              <i class="bi bi-person-plus-fill"></i>登録
            <% end %>
          </div>
        <% end %>
        <p class="text-center mt-4 mb-0">
        <%= link_to "登録済みの方はこちらからログインしてください", new_user_session_path, class: "auth-link" %>
        </p>
      </div>
    </div>
  </div>
</main>
