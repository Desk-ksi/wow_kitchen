<main>
  <section class="top-hero">
    <div class="container">
      <div class="row align-items-center g-4 g-lg-5">
        <!-- 左:キャッチコピーと気分入力 -->
        <div class="col-lg-6 order-2 order-lg-1">
          <div class="wk-tag">
            <i class="bi bi-geo-alt-fill"></i>GLOBAL HOME COOKING
          </div>
          <h1 class="top-hero-title">
            今日の食卓は<br><span class="wk-marker">海外の気分！</span>
          </h1>
          <p class="top-hero-lead">食べたいものの雰囲気を伝えて海外の料理を楽しもう！</p>
          <p class="top-hero-catch">
            <i class="bi bi-megaphone-fill text-warning"></i>Wow！な料理で日常にWow！を
          </p>
          <div class="top-search-box">
            <%= form_with url: "#", data: { turbo: false } do |form| %>
              <div class="top-search-label">
                <%= form.label :mood do %>
                  <i class="bi bi-pencil-square text-danger me-1"></i>今日は何が食べたい？
                <% end %>
                <span class="text-muted small">200文字以内</span>
              </div>
              <%= form.text_area :mood,
                    class: "form-control top-textarea mb-3",
                    rows: 3,
                    placeholder: "例：コストコの塊肉をカロリー爆上げで食べたい" %>
              <div class="d-flex flex-column flex-sm-row align-items-sm-center justify-content-between gap-3">
                <%= link_to "#", class: "top-register-link" do %>
                  <i class="bi bi-airplane-fill"></i> ユーザー登録して海外の料理を楽しもう！
                <% end %>
                <%= form.button class: "wk-btn wk-btn-primary" do %>
                  検索！<i class="bi bi-search"></i>
                <% end %>
              </div>
            <% end %>
          </div>
        </div>
        <!-- 右:メインビジュアル -->
        <div class="col-lg-6 order-1 order-lg-2">
          <div class="top-poster">
            <%= image_tag "wow_kitchen_top.jpeg", alt: "世界の屋台グルメ" %>
            <span class="top-sticker top-sticker-1"><i class="bi bi-fire text-danger"></i>COOK THE WORLD</span>
            <span class="top-sticker top-sticker-2"><i class="bi bi-translate me-1"></i>海外レシピを日本語で</span>
          </div>
        </div>
      </div>
    </div>
  </section>

